{
  "kind": "markdown_pdf",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Markdown PDF",
  "description": "Converts a Markdown input into a PDF with Pandoc.",
  "category": "Sorties",
  "inspector": {
    "title": "Markdown PDF"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "markdown",
        "title": "Markdown",
        "accepts": [
          "text/markdown",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "many",
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "pdf",
        "title": "PDF",
        "emits": [
          "file/path",
          "application/pdf",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "output_path": "exports/tmp.pdf",
    "from_format": "markdown",
    "paper_size": "a4",
    "margin": "20mm",
    "toc": false,
    "metadata_title": "",
    "timeout_sec": 120
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "mini_node_card": [
      {
        "kind": "css",
        "path": "mini/node_card.css"
      },
      {
        "kind": "js",
        "path": "mini/node_card.js"
      }
    ]
  }
}
